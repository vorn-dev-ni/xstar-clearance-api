// ============================================
// INCOME & REVENUE
// ============================================

model IncomeRecord {
  id           String      @id @default(cuid())
  recordNumber String      @unique // Auto-generated
  recordDate   DateTime
  description  String // Service description
  serviceType  String // references ServiceType.code (accounting-managed config)

  // Customer info
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Amount
  amount   Decimal @db.Decimal(15, 2)
  currency String  @default("USD")

  // Invoice/Bill reference (manual input)
  invoiceNumber   String?
  billNumber      String? // BL Number, etc.
  referenceNumber String? // For tracking

  // Where this revenue came from. MANUAL rows are keyed in by staff and post to the
  // ledger; INVOICE rows are auto-created when an invoice is fully paid — they exist for
  // the revenue register/reports only and are NOT posted to the journal (the invoice's own
  // A/R + revenue postings are the ledger source of truth, so posting again would double
  // count revenue). See [[invoice-income-link]].
  source    IncomeSource @default(MANUAL)
  // One reporting-only income row per fully-paid invoice (unique = idempotent trigger).
  invoiceId String?      @unique
  invoice   Invoice?     @relation("InvoiceIncome", fields: [invoiceId], references: [id])

  // Company income statement fields
  receivedFrom     String? // userId of the staff who received it
  receivedFromUser User?    @relation("IncomeReceivedBy", fields: [receivedFrom], references: [id])
  receivedFromName String? // free-text payer / account name (B/L costing income line)
  balance          Decimal? @db.Decimal(15, 2)

  // Accounting
  accountId String
  account   Account           @relation(fields: [accountId], references: [id])
  status    TransactionStatus @default(PENDING)

  // Manual approval flow (operators approve/reject in-form; admin need not be present)
  approvalStatus  ApprovalStatus @default(PENDING)
  approvedBy      String?
  approvalDate    DateTime?
  rejectionReason String?

  // Details
  containerCount Int? // For shipping
  quantity       Int?
  unitPrice      Decimal? @db.Decimal(15, 2)
  notes          String?
  attachmentUrl  String?

  // Tracking
  createdBy     String
  createdByUser User      @relation(fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  recordedDate  DateTime? // Actual accounting date

  // Relations
  journalEntry  JournalEntry[]
  clearanceJobs ClearanceJob[]

  // Optional link: revenue earned on a clearance job (job costing)
  clearanceJobId String?
  clearanceJob   ClearanceJob? @relation("JobIncomes", fields: [clearanceJobId], references: [id])

  @@index([customerId])
  @@index([clearanceJobId])
  @@index([recordDate])
  @@index([serviceType])
  @@index([status])
  @@index([approvalStatus])
  @@index([invoiceId])
}

enum IncomeSource {
  MANUAL
  INVOICE
}

/// Accounting-managed income service types (CRUD). `code` is stored on
/// IncomeRecord.serviceType; `name` is the editable display label.
model ServiceType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
