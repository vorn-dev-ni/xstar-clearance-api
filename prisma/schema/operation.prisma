// ============================================
// OPERATIONS — CUSTOMS CLEARANCE JOBS
// ============================================

/// A customs-clearance/shipment job register for S.T STAR. `jobNumber` is
/// entered manually by staff (unique). Controlled fields (shipment status, port
/// clearance, transaction) are free text by design. `blBookingNumber` may be
/// linked to an income record via `incomeRecordId`.
model ClearanceJob {
  id             String     @id @default(cuid())
  jobNumber      String     @unique // manual or auto-generated (IMP/EXP/JOB-YYYY-NNNN)
  date           DateTime
  status         JobStatus? // workflow status; null on legacy rows (see shipmentStatus)
  shipmentStatus String? // legacy free text, kept for old rows

  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  customerName String? // manual/denormalized display

  sizeVolume      String?
  invoiceNumber   String?
  blBookingNumber String? // primary B/L (= blBookingNumbers[0]); e.g. 026F5222213
  blBookingNumbers String[] @default([]) // all B/Ls on this shipment (mostly 1, sometimes 2)

  // Optional link: BL/booking → income record
  incomeRecordId String?
  incomeRecord   IncomeRecord? @relation(fields: [incomeRecordId], references: [id])

  commodity     String? // HAND TOWEL, FACIAL TISSUE, ...
  portClearance String? // PPAP / SHV / TL
  transaction   String? // IMP / EXP
  notice        String? // PASSED THIS SHIPMENT TO RLS, CLEARANCE BY S.T
  contacts      String? // by mr.wei, by mr jason
  other         String?

  // Shipment details (all optional — filled when available)
  originCountry      String?
  originPort         String?
  destinationCountry String?
  destinationPort    String? // POD — port of discharge
  transportMode      TransportMode?
  shipperDetails     String?
  consigneeDetails   String?
  eta                DateTime? // expected arrival date
  goodsValue         Decimal?       @db.Decimal(15, 2) // commercial invoice value
  goodsCurrency      String?
  incoterms          String? // FOB, CIF, EXW, DDP, ...

  // Covering-file details (Import Shipment Details template)
  importer          String?
  hsCode            String? // customs HS code
  vesselVoyage      String? // feeder vessel / voyage
  containerType     String?
  shipmentMode      ShipmentMode?
  shipmentTaxStatus ShipmentTaxStatus?
  clearanceType     ClearanceType?
  packageCount      Int?
  netWeight         String?
  grossWeight       String?
  deliveryTo        String?
  unloadingBy       String?
  returnEmptyTo     String? // return MT (empty container) to

  // Job costing
  estimatedRevenue  Decimal? @db.Decimal(15, 2)
  estimatedCost     Decimal? @db.Decimal(15, 2)
  assignedStaffId   String?
  assignedStaffUser User?    @relation("JobAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignedStaff     String? // manual/denormalized display
  brokerName        String?

  // Billing (the job doubles as the client-facing bill)
  issueClearanceDate DateTime?
  totalAmount        Decimal?  @db.Decimal(15, 2) // agreed total incl. tax & expenses
  depositAmount      Decimal?  @db.Decimal(15, 2) // client prepayment

  expenses       ExpenseRecord[]
  incomes        IncomeRecord[]        @relation("JobIncomes")
  invoices       Invoice[]
  vendorPayments VendorPayment[]
  deposits       Deposit[]
  recordItems    BillRecordItem[]
  expenseItems   BillExpenseItem[]
  bondedItems    BondedWarehouseItem[]
  clearancePlans ClearancePlan[]

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([assignedStaffId])
  @@index([date])
  @@index([jobNumber])
  @@index([status])
}

enum TransportMode {
  AIR
  SEA
  LAND
  COURIER
}

/// Bill-of-lading / shipment workflow lifecycle (see the covering-file process).
/// Independent from the container-deposit lifecycle (see ContainerDepositStatus).
enum JobStatus {
  DRAFT_BL_RECEIVED
  FINAL_BL_RECEIVED
  BL_VERIFIED
  BL_SUBMITTED_FOR_CUSTOMS
  CUSTOMS_DECLARATION_SUBMITTED
  CUSTOMS_CLEARANCE_COMPLETED
  CONTAINER_RELEASED
  DELIVERY_COMPLETED
  FILE_CLOSED
}

enum ShipmentMode {
  IMPORT
  TEMPORARY_IMPORT
  PRE_CLEARANCE_IMPORT
  BONDED_WAREHOUSE
  OTHER
}

/// Tax treatment of the shipment (from the covering-file "Shipment status" box).
enum ShipmentTaxStatus {
  PAY_VAT
  DEBIT_NOTE_ONLY
}

/// Customs clearance regime for the shipment (required on new shipments).
/// BONDED_CLEARANCE carries bonded-warehouse goods and gates the Bonded Items tab.
enum ClearanceType {
  NORMAL_CLEARANCE
  LAMSAM_CLEARANCE
  BONDED_CLEARANCE
}

/// Inline product/service rows on a bill (clearance job). Lightweight — not
/// accounting records; the linked ExpenseRecord/IncomeRecord stay separate.
model BillRecordItem {
  id             String       @id @default(cuid())
  clearanceJobId String
  clearanceJob   ClearanceJob @relation(fields: [clearanceJobId], references: [id], onDelete: Cascade)
  itemNumber     Int
  description    String
  quantity       Decimal      @db.Decimal(15, 4)
  hsCode         Decimal      @db.Decimal(15, 2)
  amount         Decimal      @db.Decimal(15, 2) // computed = quantity * hsCode

  @@index([clearanceJobId])
}

/// Inline expense rows on a bill (clearance job).
model BillExpenseItem {
  id             String       @id @default(cuid())
  clearanceJobId String
  clearanceJob   ClearanceJob @relation(fields: [clearanceJobId], references: [id], onDelete: Cascade)
  itemNumber     Int
  description    String
  amount         Decimal      @db.Decimal(15, 2)
  invoiceNumber  String? // optional Invoice/CM # reference

  @@index([clearanceJobId])
}

/// Clearance-plan container row (the "CLEARANCE PLANS" sheet). Each row is one
/// container linked to a Shipment (ClearanceJob) — the Bill of Loading is the
/// linked job's blBookingNumber.
model ClearancePlan {
  id             String       @id @default(cuid())
  clearanceJobId String
  clearanceJob   ClearanceJob @relation(fields: [clearanceJobId], references: [id])
  consignee      String?
  container      String // container number (per-row key)
  size           String? // e.g. 40'
  seal           String?
  commodity      String? // renamed from the sheet's "COMMUNITY"
  port           String? // e.g. TEC
  clearanceDate  DateTime?
  notes          String?
  status         ClearancePlanStatus @default(TRANSIT_DOCS_APPROVED)
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([clearanceJobId]) // a shipment may be linked to at most one clearance plan
  @@index([clearanceDate])
  @@index([status])
}

/// Step-by-step clearance lifecycle for a ClearancePlan container row. Advances
/// one step at a time; CLEARANCE_COMPLETED is terminal (locked once reached).
enum ClearancePlanStatus {
  TRANSIT_DOCS_APPROVED
  CONTAINER_ARRIVED_DRY_PORT
  CUSTOMS_VALUATION_APPROVED
  CLEARANCE_IN_PROGRESS
  CLEARANCE_COMPLETED
}
