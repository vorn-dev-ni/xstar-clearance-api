// ============================================
// EXPENSES & COSTS
// ============================================

model ExpenseRecord {
  id           String      @id @default(cuid())
  recordNumber String      @unique
  recordDate   DateTime
  description  String // Expense description
  expenseType  String // references ExpenseType.code (accounting-managed config)

  // Supplier info
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  supplierName String? // If no supplier in system

  // Amount
  amount   Decimal @db.Decimal(15, 2)
  currency String  @default("USD")

  // Costing statement fields
  taxRate    Decimal? @db.Decimal(5, 2) // percentage
  taxAmount  Decimal? @db.Decimal(15, 2)
  deposit    Decimal? @db.Decimal(15, 2)
  actualCost Decimal? @db.Decimal(15, 2)

  // Accounting — the expense account now lives per line item (ExpenseItem.accountId);
  // this header-level account is kept optional for legacy/single-line callers.
  accountId String?
  account   Account?          @relation(fields: [accountId], references: [id])
  status    TransactionStatus @default(PENDING)

  // Invoice/PO reference
  invoiceNumber   String?
  poNumber        String?
  referenceNumber String?

  // Approval
  approvalStatus  ApprovalStatus @default(PENDING)
  approvedBy      String?
  approvalDate    DateTime?
  rejectionReason String?

  // Payment-voucher header fields
  purpose       String? // Voucher "Purpose" line
  accountNumber String? // Payee bank account number (manual)
  accountName   String? // Payee bank account name (manual)
  cashAdvance   Decimal  @default(0) @db.Decimal(15, 2) // LESS: Cash Advance
  paymentMethod String? // CASH | CHEQUE (ticks the voucher box)
  note          String? // Voucher "Note:" line

  // Voucher line items
  items ExpenseItem[]

  // Details
  quantity      Int?
  unitCost      Decimal? @db.Decimal(15, 2)
  notes         String?
  attachmentUrl String?

  // Tracking
  createdBy     String
  createdByUser User      @relation(fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  recordedDate  DateTime?

  // Relations
  journalEntry   JournalEntry[]
  vendorPayments VendorPayment[]

  // Optional link: expense incurred for a clearance job (job costing)
  clearanceJobId String?
  clearanceJob   ClearanceJob? @relation(fields: [clearanceJobId], references: [id])

  @@index([supplierId])
  @@index([clearanceJobId])
  @@index([recordDate])
  @@index([expenseType])
  @@index([status])
  @@index([approvalStatus])
}

/// One line of a payment voucher (Item No · A/C Code · Date · Invoice No ·
/// Description · Amount). The parent ExpenseRecord.amount = sum of item amounts.
model ExpenseItem {
  id              String        @id @default(cuid())
  expenseRecordId String
  expenseRecord   ExpenseRecord @relation(fields: [expenseRecordId], references: [id], onDelete: Cascade)

  itemNumber    Int
  acCode        String? // Legacy A/C code text (superseded by accountId)
  accountId     String? // Expense account (chart of accounts) this line debits
  account       Account?  @relation(fields: [accountId], references: [id])
  itemDate      DateTime? // Line date; defaults to the record date on the voucher
  invoiceNumber String?
  description   String
  amount        Decimal  @db.Decimal(15, 2)
  tax           Decimal? @db.Decimal(15, 2) // per-line tax (mirrors a BL cost line)
  deposit       Decimal? @db.Decimal(15, 2) // per-line container deposit

  createdAt DateTime @default(now())

  @@index([expenseRecordId])
  @@index([accountId])
}

/// Accounting-managed expense types (CRUD). `code` is stored on
/// ExpenseRecord.expenseType; `name` is the editable display label.
model ExpenseType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
}
